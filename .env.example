# Supabase Postgres connection string (Session pooler, port 5432).
# Everything else (settings, mapping, series) lives in the einvoice.* tables.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

PORT=3000
DEBUG=false

# Local development only: run the worker / poll / reconcile on timers instead of pg_cron.
INPROCESS_SCHEDULER=false

# Local development only: read secrets from env when they are not in Vault.
# In production every credential lives in Supabase Vault (FR-ERR-02).
ALLOW_ENV_SECRETS=false
# SG_API_KEY=
# SG_WEBHOOK_SECRET=
# CRON_SECRET=
# IMPACT_UAT_API_KEY=
